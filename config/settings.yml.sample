# -*- yaml -*-
# Values formatted like "_env:ENV_VAR_NAME:default_value" can be overridden by the specified environment variable.
# See https://github.com/yesodweb/yesod/wiki/Configuration#overriding-configuration-values-with-environment-variables

# Static files are found in this directory
static-dir:     "_env:STATIC_DIR:static"
# Unix socket to use instead of (and ignoring) the host and port settings. If
# enabled, please configure manually the secure sessions and strict transport
# security settings.
# unix-socket:  /var/run/corydalis/socket
# Group and permissions of the Unix socket, which a reverse proxy
# running as another user needs to connect (connecting needs write
# permission); see the installation documentation. Corydalis' user must
# be a member of the group. The mode must be quoted. By default, the
# socket gets the process' group, and its permissions from the umask.
# unix-socket-group: corydalis-socket
# unix-socket-mode: "0660"
# Listen address:
host:           "_env:HOST:*4" # any IPv4 host
# Listen port:
port:           "_env:PORT:3000"
# Whether to enable and require HTTPS. If enabled, the server will not
# work with plain connection on the same port, and furthermore, it
# will enforce the secure-cookies setting.
https:          true
# Whether to require secure sessions, i.e. only send the session
# cookies over HTTPS. This defaults to true, and when https is true
# (without a Unix socket), it is forced to true. Behind a reverse proxy
# serving HTTPS, keep it enabled; set it to false only when serving
# plain HTTP, other than on localhost (browsers don't keep secure
# cookies received over plain HTTP, so logging in wouldn't work).
secure-sessions: true
# Emit a Strict-Transport-Security header in the response. This
# defaults to the https parameter (but to false with unix-socket,
# which ignores https); in case of plain http, it can be
# useful when reverse proxied. However, it's preferable to configure
# this in the reverse proxy itself, since that's more commonly done
# on the entire (apex) domain (e.g. on example.com), rather than in
# individual apps like Corydalis, hosted on a leaf name (e.g.
# corydalis.example.com).
# strict-transport-security: true/false
# Canonical URL:
approot:        "_env:APPROOT:http://localhost:3000"
# Useful when running behind a reverse proxy:
ip-from-header: "_env:IP_FROM_HEADER:false"
# How long a login is valid, in hours, regardless of activity; after
# this, users have to log in again. Independently of this, sessions
# also expire after two hours without activity. Defaults to a week.
# session-max-age: 168

# How many external tools (ImageMagick, ffmpeg, exiftool) may run at
# once to build previews; further previews wait. Defaults to the number
# of processors the application uses.
# render-tool-slots: 4
# How long, in seconds, such a tool may run before it is stopped, and
# the preview fails. Defaults to five minutes.
# render-tool-timeout: 300

# The same limits, separately, for the scan's exiftool runs, which read
# the metadata of batches of files: how many runs at once (defaults to
# the number of processors the application uses), and for how long, in
# seconds, before a run is stopped and the metadata of all the files of
# its batch fails (defaults to ten minutes). The previews the scan
# renders afterwards use the render-tool-* limits.
# scan-tool-slots: 4
# scan-tool-timeout: 600

# Custom message to show on login page
#login-msg:      "Hello, *brave* user!"

# Custom message to show on the home page, right below the
# header. This could be useful for a public or demo site. NOTE: the
# value will be used as-is, unescaped, so be careful if you use any
# HTML tags.
#home-msg: >
#  <p>
#    This is a demo site for
#    <a href="https://github.com/iustin/corydalis" target="_blank">Corydalis</a>.
#    Visit the github page for the source code, or you can
#    <a href="https://corydalis.readthedocs.io/" target="_blank">read the docs</a>
#    online.
#  </p>

# NB: If you need a numeric value (e.g. 123) to parse as a String, wrap it in single quotes (e.g. "_env:PGPASS:'123'")
# See https://github.com/yesodweb/yesod/wiki/Configuration#parsing-numeric-values-as-strings

database:
  # See config/test-settings.yml for an override during tests
  database: "_env:SQLITE_DATABASE:db/corydalis.sqlite3"
  poolsize: "_env:SQLITE_POOLSIZE:10"

# Optional values with the following production defaults.
# In development, they default to the inverse.
#
# development: false
# Request (HTTP) logs: one of "disabled", "apache" or "detailed"; the
# detailed format is meant for debugging, and writes several lines per
# request: each line is escaped, but (unlike in the other logs) newlines
# within the logged text are kept, as they can't be told apart from the
# format's own (HTTP doesn't allow them in the path and headers, though).
# request-logging: "apache"
# should-log-all: false
# Log level: choose one of debug, info, warning, error. The application will
# only log messages with this severity or higher. Note these are different
# from the request (HTTP) logs.
# log-level: "info"

config:
  # The picture and cache directories below must be absolute paths.
  # List of directories holding source pictures:
  sourcedirs: ["/pics/raw"]
  # List of directories containing output pictures:
  outputdirs: ["/pics/jpegs"]
  # Don't recurse into any subdirs listed here:
  blacklisteddirs: [".thumbnails"]
  # Where to store the generated thumbnails and small size previews
  cachedir: "/pics/cache"
  # Thumbnail size. Previews at this size or lower will be generated
  # in an optimised way (see ImageMagick convert's "-thumbnail"
  # option), stripping unneeded information, and saved as PNGs; images
  # above will be saved as JPEGs.
  thumbnailsize: 64
  # Browsing image size. This is the longest-side size that images
  # will be rendered at in browsing mode; they will be scaled down
  # based on browser view-port size, so this should be large enough to
  # accommodate enough images without white-space. Currently in large
  # size (bootstrap 'xl', i.e. > 1200px width), the templates will
  # generate 3 columns, so ensure this is ≥ display_size/3.
  browsingsize: 1024
  # Automatically-generated image sizes; recommended to include common
  # resolutions the pictures will be viewed at and thumbnail sizes
  # (64×64, 128×128). You can list the entries in any order (they will
  # be used in sorted order), but it's more readable to list them
  # sorted as well. Note that the values "thumbnailsize" and
  # "browsingsize" above are automatically added to this list.
  autoimgsizes: [1920, 2560]
  # Other image sizes that will be generated and saved to cachedir,
  # but only on demand. If a value appears both here and in
  # autoimgsizes, the entry here will have no effect. On a site
  # anonymous visitors can browse (built with the public-site flag),
  # anyone can request these for every picture, and fill the cache:
  # consider an empty list ([]) there.
  demandimgsizes: [3840, 7680]
  # Page size to use when browsing images. Should be kept low to speed
  # up initial page load.
  pagesize: 16
  # List of extensions considered "RAW" files:
  rawexts: ["nef", "raf", "orf", "crw", "tif", "tiff", "dng"]
  # List of extensions considered processed pictures:
  jpegexts: ["jpg", "jpeg"]
  # List of extensions for sidecar files:
  sidecarexts: ["xmp"]
  # List of other extensions (e.g. thumbnail files):
  otherexts: ["png"]
  # List of movie extensions:
  movieexts: ["mp4", "mov", "avi"]
  # List of extensions that are directly viewable in-browser, and thus
  # don't need conversion to jpeg.
  viewableimages: ["png", "jpg", "jpeg", "tiff", "tif"]
  # ImageMagick decoder to use, for each extension, when building
  # previews. The decoder is passed explicitly, since otherwise
  # ImageMagick guesses it from the file contents, and could e.g.
  # run a PostScript document named "photo.jpg". Extensions and decoders
  # are case-insensitive; files with an extension not listed here get
  # no previews. Decoders which can run programs or read other files
  # (e.g. PostScript, PDF, SVG, MVG) are refused. Previews of embedded
  # images and movie frames are always decoded as JPEGs. The default
  # is:
  # imagedecoders:
  #   jpg: jpeg
  #   jpeg: jpeg
  #   heic: heic
  #   heif: heic
  #   tif: tiff
  #   tiff: tiff
  #   png: png
  #   webp: webp
  # ffmpeg demuxer (container format) to use, for each movie extension,
  # when extracting the first frame of movies without an embedded
  # preview. As for images, the format is passed explicitly, since
  # otherwise ffmpeg guesses it from the file contents, and some formats
  # (e.g. playlists or concat scripts) make it read other files.
  # Extensions and demuxers are case-insensitive; movies with an
  # extension not listed here get no extracted frame. Only plain
  # container formats are accepted: mov (which covers MP4 and 3GP), avi,
  # matroska (which covers WebM), mpegts, mpeg, asf and ogg. The default
  # is:
  # moviedemuxers:
  #   mp4: mov
  #   m4v: mov
  #   mov: mov
  #   3gp: mov
  #   avi: avi
  #   mkv: matroska
  #   webm: matroska
  #   mts: mpegts
  #   m2ts: mpegts
  #   mpg: mpeg
  #   mpeg: mpeg
  # Directory holding the ImageMagick security policy to use when
  # building previews (see config/magick/policy.xml in the sources, and
  # the installation documentation). If set, the application refuses to
  # start unless ImageMagick actually loads the policy from there.
  magickpolicydir: "config/magick"
  # Valid directory pattern (groups are ignored): a directory whose
  # name matches is a picture folder, and other directories are
  # searched for picture folders:
  dirregex: "([0-9]{4}-[0-9]{2}-[0-9]{2})(.*)"
  # How deep below the source and output directories picture folders
  # are looked for (1 means only their direct sub-directories); must
  # be positive, and the default is 4. Previous versions of Corydalis
  # only looked at depth 2 (a fixed `year/folder` structure), which
  # is close to, but not exactly the same as setting this to 2.
  # maxfolderdepth: 4
  # Regex denoting the name of a picture composed from other
  # pictures, e.g. panoramas; exactly three groups are expected, in
  # order: base filename, start index, end index.
  rangeregex: "^(.*_)([0-9]+)-([0-9]+)$"
  # Copy regex: the first group is the base filename, any other
  # groups are ignored:
  copyregex: "^(.*)(-([0-9]|Edit))$"
  # Prefix in Hierarchical Subject keywords that denote entries
  # underneath it represent people. This keyword itself will be
  # ignored. Additionally, the tag 'PeopleInImage' will also be used,
  # but without using/requiring this prefix.
  peopleprefix: "_People"
  # Ignore any (individual) keywords prefixed with this string. Again,
  # useful for hierarchies.
  ignoreprefix: "_"
