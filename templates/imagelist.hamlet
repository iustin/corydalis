        <table #imagelist .tablesorter .table .table-sm .vmiddle data-sortlist="#{sortColumnsEnc}">
              <col style="width: #{thumbsize}px;">
              <thead>
                $# No .filter-select on columns showing file names or EXIF
                $# data: tablesorter builds the select options as HTML from
                $# the cell texts, so these would allow markup injection.
                <tr>
                  <th .parser-false .sorter-false .filter-false>Icon
                  $if showParent
                    <th .sorter-text .group-text>Folder
                  <th .group-false>Name
                  <th .sorter-text .group-false>Capture date
                  $if numCameras > 1
                    <th .group-text>Camera
                  $if numLenses > 1
                    <th .group-text>Lens
                  $if not hideStatus
                    <th .filter-select>Status
              <tbody>
                $forall img@Image{imgExif=e, imgParent=p, imgStatus=s} <- images
                  <tr .#{imgRowClass img}>
                    <td>
                      ^{imageLinkWrapper img params $ imageBytes thumbsize img}
                    $if showParent
                      <td>
                        <a href=@{FolderR p}>
                          <span .fa-regular .fa-folder>
                          #{p}
                    <td>
                        <a href=@{ImageR p (imgName img)}>#{imgName img}
                    <td>#{showExifDate img}
                    $if numCameras > 1
                      <td>
                        ^{showCameraLink (maybeDesymbolizeItem' $ exifCamera e)}
                    $if numLenses > 1
                      <td>
                        <a href="@{lensInfoRoute (exifLens e)}">
                          #{lensDisplayName (exifLens e) }
                    $if not hideStatus
                      <td data-text="#{showImageStatus s}">
                        <span title="#{showImageStatus s}">
                          $forall iclass <- isIcon s
                            <span class="#{iclass}">
              <tfoot>
