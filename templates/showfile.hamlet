<table .table .m-0>
  <tr>
    <td>Name
    <td><span class="monolight">#{Repository.fileRelPath f}</span>
  <tr>
    <td>Path
    <td><span class="monolight">#{quoteMarkup $ showPath $ Repository.fileFullPath f}
  <tr>
    <td>Last modified
    <td><span class="monolight">#{showTimestamp $ Repository.fileMTime f}
  <tr>
    <td>Size
    <td .numeric><span class="monolight">#{showBinary $ Repository.fileSize f}
  ^{showExif (fileExif f)}
