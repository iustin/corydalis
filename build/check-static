# Checks the files served from static/ (see "Static files" in
# docs/devel.md): that no symbolic link is broken, and that every file
# is used, either by the server (via its route name, as generated by
# 'staticFiles' in Settings/StaticFiles.hs) or by a served CSS file (via
# its /static/ path, e.g. the fonts). Run from the root of the
# repository, after 'make bootstrap', since some of the files are
# generated or link into node_modules.

set -euo pipefail

if [ ! -d static ] || [ ! -d src ]; then
  echo "Run from the root of the repository" >&2
  exit 1
fi

rc=0

# Broken symbolic links, e.g. to a package no longer installed.
while IFS= read -r link; do
  echo "Broken symbolic link: $link -> $(readlink "$link")" >&2
  rc=1
done < <(find static -xtype l | sort)

# The route name that staticFiles generates for a path: characters other
# than ASCII letters and digits become underscores, and the name gets an
# underscore prefix unless it starts with a lowercase letter.
route_name() {
  local name
  name=$(printf '%s' "$1" | LC_ALL=C sed 's/[^A-Za-z0-9]/_/g')
  case "$name" in
    [a-z]*) printf '%s' "$name" ;;
    *) printf '_%s' "$name" ;;
  esac
}

# Files that the server serves; static/tmp (written at runtime) and
# static/combined (written by the build) are generated.
while IFS= read -r file; do
  rel=${file#static/}
  name=$(route_name "$rel")
  if grep -rqw -- "$name" src templates; then
    continue
  fi
  if grep -rqF --include='*.css' -- "/static/$rel" static; then
    continue
  fi
  echo "Unused static file: $file (no '$name' route in src/ or templates/," \
       "nor '/static/$rel' in a CSS file)" >&2
  rc=1
done < <(find static \( -type f -o -type l \) \
           -not -path 'static/tmp/*' -not -path 'static/combined/*' | sort)

if [ "$rc" -ne 0 ]; then
  echo "See \"Static files\" in docs/devel.md." >&2
fi
exit "$rc"
