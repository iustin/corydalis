# Checks the files served from static/ (see "Static files" in
# docs/devel.md): that there are no symbolic links (libraries are
# bundled by esbuild instead), and that every file is used by the server
# (via its route name, as generated in Settings/StaticFiles.hs). Run
# from the root of the repository, after 'make bootstrap', since most of
# the files are generated by esbuild.

set -euo pipefail

if [ ! -d static ] || [ ! -d src ]; then
  echo "Run from the root of the repository" >&2
  exit 1
fi

rc=0

# Symbolic links, e.g. into node_modules: bundle the file instead.
while IFS= read -r link; do
  echo "Symbolic link: $link -> $(readlink "$link")" >&2
  rc=1
done < <(find static -type l | sort)

# The route name generated for a path (by 'pathToName', from
# yesod-static): characters other than ASCII letters and digits become
# underscores, and the name gets an underscore prefix unless it starts
# with a lowercase letter.
route_name() {
  local name
  name=$(printf '%s' "$1" | LC_ALL=C sed 's/[^A-Za-z0-9]/_/g')
  case "$name" in
    [a-z]*) printf '%s' "$name" ;;
    *) printf '_%s' "$name" ;;
  esac
}

# Files that the server serves (hidden ones are skipped, see
# Settings/StaticFiles.hs); static/corydalis/fonts is written by
# esbuild, with only the fonts the CSS bundle uses, which it refers to
# by relative URLs, not route names.
while IFS= read -r file; do
  rel=${file#static/}
  name=$(route_name "$rel")
  if grep -rqw -- "$name" src templates; then
    continue
  fi
  echo "Unused static file: $file (no '$name' route in src/ or templates/)" >&2
  rc=1
done < <(find static -type f -not -path '*/.*' \
           -not -path 'static/corydalis/fonts/*' | sort)

if [ "$rc" -ne 0 ]; then
  echo "See \"Static files\" in docs/devel.md." >&2
fi
exit "$rc"
